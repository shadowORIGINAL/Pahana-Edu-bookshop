package com.pahanaedu.controller;

import com.pahanaedu.model.*;
import com.pahanaedu.service.*;

import javax.servlet.*;
import javax.servlet.http.*;
import java.io.IOException;
import java.util.*;

public class ManageOrdersServlet extends HttpServlet {
    private final OrderService orderService = new OrderService();
    private final UserService userService = new UserService();
    private final ProductService productService = new ProductService();

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        HttpSession session = request.getSession(false);
        User user = session != null ? (User) session.getAttribute("user") : null;

        if (user == null) {
            response.sendRedirect("login.jsp");
            return;
        }

        String action = request.getParameter("action");
        if (action == null) action = "";

        try {
            switch (action) {
                case "new":
                    handleNewOrderView(request, response, user);
                    break;
                case "view":
                    handleOrderView(request, response, user);
                    break;
                case "history":
                default:
                    handleOrderList(request, response, user);
                    break;
            }
        } catch (Exception e) {
            handleError(request, response, user, e);
        }
    }

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        HttpSession session = request.getSession(false);
        User user = session != null ? (User) session.getAttribute("user") : null;

        if (user == null || (!user.getRole().equals("ADMIN") && !user.getRole().equals("STAFF"))) {
            response.sendRedirect("login.jsp");
            return;
        }

        try {
            if ("create".equals(request.getParameter("action"))) {
                Order createdOrder = processOrderCreation(request, user);
                session.setAttribute("orderSuccess", "Order #" + createdOrder.getOrderId() + " created successfully!");
                response.sendRedirect("ManageOrdersServlet?action=view&id=" + createdOrder.getOrderId());
            } else {
                throw new ServletException("Invalid action: " + request.getParameter("action"));
            }
        } catch (Exception e) {
            handleOrderCreationError(request, response, e);
        }
    }

    private void handleNewOrderView(HttpServletRequest request, HttpServletResponse response, User user)
            throws Exception {
        if (!user.getRole().equals("ADMIN") && !user.getRole().equals("STAFF")) {
            response.sendError(HttpServletResponse.SC_FORBIDDEN, "Access denied");
            return;
        }

        List<User> customers = userService.getAllCustomers();
        List<Product> products = productService.getAllProducts(true);
        request.setAttribute("customers", customers);
        request.setAttribute("products", products);
        request.getRequestDispatcher("create_order.jsp").forward(request, response);
    }

    private void handleOrderView(HttpServletRequest request, HttpServletResponse response, User user)
            throws Exception {
        long orderId = Long.parseLong(request.getParameter("id"));
        Order order = orderService.getOrderById(orderId);

        if (!user.getRole().equals("ADMIN") && !user.getRole().equals("STAFF") && 
            !order.getCustomerId().equals(user.getId())) {
            response.sendError(HttpServletResponse.SC_FORBIDDEN, "Access denied");
            return;
        }

        request.setAttribute("order", order);
        request.getRequestDispatcher("view_order.jsp").forward(request, response);
    }

    private void handleOrderList(HttpServletRequest request, HttpServletResponse response, User user)
            throws Exception {
        List<Order> orders;
        if (user.getRole().equals("ADMIN") || user.getRole().equals("STAFF")) {
            orders = orderService.getAllOrders();
            request.setAttribute("orders", orders);
            request.getRequestDispatcher("order_list.jsp").forward(request, response);
        } else {
            orders = orderService.getOrdersByCustomer(user.getId());
            request.setAttribute("orders", orders);
            request.getRequestDispatcher("order_history.jsp").forward(request, response);
        }
    }

    private Order processOrderCreation(HttpServletRequest request, User user) throws Exception {
        validateOrderParameters(request);
        
        Long customerId = Long.parseLong(request.getParameter("customerId"));
        String[] productIds = request.getParameterValues("productId");
        String[] quantities = request.getParameterValues("quantity");
        String[] discountPercents = request.getParameterValues("discountPercent");

        validateArraysLength(productIds, quantities, discountPercents);

        List<OrderItem> items = createOrderItems(productIds, quantities, discountPercents);
        validateOrderItems(items);

        Order order = new Order();
        order.setCustomerId(customerId);
        order.setCreatedBy(user.getId());

        Order createdOrder = orderService.createOrder(order, items);
        
        // Update the session if the current user is the customer who placed the order
        HttpSession session = request.getSession(false);
        if (session != null && customerId.equals(user.getId())) {
            User updatedUser = userService.getUserById(user.getId());
            session.setAttribute("user", updatedUser);
        }
        
        return createdOrder;
