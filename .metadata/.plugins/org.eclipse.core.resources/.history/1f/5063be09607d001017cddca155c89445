            request.setAttribute("orders", orders);
            request.getRequestDispatcher("order_history.jsp").forward(request, response);
        }
    }

    private Order processOrderCreation(HttpServletRequest request, User user) throws Exception {
        validateOrderParameters(request);
        
        Long customerId = Long.parseLong(request.getParameter("customerId"));
        String[] productIds = request.getParameterValues("productId");
        String[] quantities = request.getParameterValues("quantity");
        String[] discountPercents = request.getParameterValues("discountPercent");

        validateArraysLength(productIds, quantities, discountPercents);

        List<OrderItem> items = createOrderItems(productIds, quantities, discountPercents);
        validateOrderItems(items);

        Order order = new Order();
        order.setCustomerId(customerId);
        order.setCreatedBy(user.getId());

        Order createdOrder = orderService.createOrder(order, items);
        
        // Update the session if the current user is the customer who placed the order
        HttpSession session = request.getSession(false);
        if (session != null && customerId.equals(user.getId())) {
            User updatedUser = userService.getUserById(user.getId());
            session.setAttribute("user", updatedUser);
        }
        
        return createdOrder;
    }

    private void validateOrderParameters(HttpServletRequest request) throws ServletException {
        if (request.getParameter("customerId") == null || 
            request.getParameterValues("productId") == null || 
            request.getParameterValues("quantity") == null) {
            throw new ServletException("Missing required order parameters");
        }
    }

    private void validateArraysLength(String[] productIds, String[] quantities, String[] discountPercents) 
            throws ServletException {
        if (productIds.length != quantities.length || 
            (discountPercents != null && discountPercents.length != productIds.length)) {
            throw new ServletException("Invalid order item parameters");
        }
    }

    private List<OrderItem> createOrderItems(String[] productIds, String[] quantities, String[] discountPercents) 
            throws Exception {
        List<OrderItem> items = new ArrayList<>();
        
        for (int i = 0; i < productIds.length; i++) {
            try {
                Long productId = Long.parseLong(productIds[i]);
                int quantity = Integer.parseInt(quantities[i]);
                double discount = discountPercents != null && i < discountPercents.length &&
                        !discountPercents[i].isEmpty() ? Double.parseDouble(discountPercents[i]) : 0.0;

                if (quantity <= 0) continue;

                Product product = productService.getProductById(productId);
                if (product == null) {
                    throw new ServletException("Product with ID " + productId + " not found");
                }

                validateStock(product, quantity);

                OrderItem item = new OrderItem();
                item.setProductId(productId);
                item.setQuantity(quantity);
                item.setUnitPrice(product.getPrice());
                item.setDiscountPercentage(discount);
                items.add(item);
            } catch (NumberFormatException e) {
                throw new ServletException("Invalid numeric value in order items", e);
            }
        }
        
        return items;
    }

    private void validateStock(Product product, int quantity) throws ServletException {
        if (product.getStockQuantity() < quantity) {
            throw new ServletException("Not enough stock for product: " + product.getTitle() + 
                    ". Available: " + product.getStockQuantity() + ", Requested: " + quantity);
        }
    }

    private void validateOrderItems(List<OrderItem> items) throws ServletException {
        if (items.isEmpty()) {
            throw new ServletException("Order must contain at least one item");
        }
    }

    private void handleOrderCreationError(HttpServletRequest request, HttpServletResponse response, Exception e)
            throws ServletException, IOException {
        request.setAttribute("error", "Error processing order: " + e.getMessage());
        try {
            request.setAttribute("customers", userService.getAllCustomers());
            request.setAttribute("products", productService.getAllProducts(true));
        } catch (Exception ex) {
            request.setAttribute("error", request.getAttribute("error") + " " + ex.getMessage());
        }
        request.getRequestDispatcher("create_order.jsp").forward(request, response);
    }

    private void handleError(HttpServletRequest request, HttpServletResponse response, User user, Exception e)
            throws ServletException, IOException {
        request.setAttribute("error", "Error: " + e.getMessage());
        if (user.getRole().equals("ADMIN") || user.getRole().equals("STAFF")) {
            request.getRequestDispatcher("admin_dashboard.jsp").forward(request, response);
        } else {
            request.getRequestDispatcher("customer_dashboard.jsp").forward(request, response);
        }
    }
